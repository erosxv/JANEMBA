{
  "name": "callzinha",
  "productName": "CallZinha",
  "version": "1.11.1",
  "description": "Chamada em grupo por áudio, com tela compartilhada",
  "author": "erosxv",
  "desktopName": "callzinha.desktop",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:linux": "npm run build:web && electron-builder --linux",
    "sync": "npm run build:web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "build": {
    "appId": "io.github.erosxv.callzinha",
    "productName": "CallZinha",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "syncDesktopName": true,
      "maintainer": "erosxv",
      "icon": "icons/icon-512.png",
      "category": "Network"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  }
}
